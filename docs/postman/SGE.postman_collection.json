      "item": [
        {
          "name": "Create or Update Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('admin created', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/create-admin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "create-admin"]
            }
          }
        },
        {
          "name": "Register User Etudiant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('user registered or already exists', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"etudiant\",\n  \"password\": \"etudiant123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login Admin",
